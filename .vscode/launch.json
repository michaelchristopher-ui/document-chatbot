{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Streamlit: Run app.py",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python3",
      "module": "streamlit",
      "args": ["run", "app.py", "--server.headless", "true"],
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true
    }
  ]
}
